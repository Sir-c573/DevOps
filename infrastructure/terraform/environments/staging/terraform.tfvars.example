# Copy to terraform.tfvars (git-ignored) and adjust.
project_name       = "picsart-devops-staging"
aws_region         = "us-east-1"
availability_zone  = "us-east-1a"

vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

instance_type      = "t3.micro"

# Size in GiB of the data volume (releases, app data, test results).
data_volume_size   = 10

# Bucket for static files only. Must be globally unique across all of AWS.
bucket_name        = "picsart-devops-staging-2026-unique123"

github_repository  = "Sir-c573/DevOps"
github_oidc_repository = "Sir-c573@192271267/DevOps@1432981893"